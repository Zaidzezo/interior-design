{
  "name": "buildspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @buildspace/web dev",
    "build": "pnpm --filter @buildspace/web build",
    "start": "pnpm --filter @buildspace/web start",
    "typecheck": "pnpm --filter @buildspace/web typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "pg": "8.16.3",
    "dotenv": "17.2.3"
  },
  "devDependencies": {
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "tsx": "4.20.6",
    "@types/pg": "8.15.5"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}
