{
  "name": "buildspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @buildspace/web dev",
    "build": "pnpm --filter @buildspace/web build",
    "start": "pnpm --filter @buildspace/web start",
    "typecheck": "pnpm --filter @buildspace/web typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "lint": "eslint ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "17.2.3",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "@types/pg": "8.15.5",
    "@types/three": "0.180.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^9.39.5",
    "meshoptimizer": "^1.3.0",
    "prisma": "7.10.1",
    "three": "0.180.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}
